{
    "name": "claude-sandbox/php-demo",
    "description": "カウンターデモアプリ (PHP版)",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CounterDemo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CounterDemo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true
    }
}
